# Allure Docker Service connection
ALLURE_BASE_URL=http://localhost:5050/allure-docker-service

# Authentication (leave empty if security is disabled)
ALLURE_USERNAME=
ALLURE_PASSWORD=

# Accept self-signed / untrusted SSL certificates for the Allure connection
ALLURE_ACCEPT_SELF_SIGNED=false

# Storage
DB_PATH=allure_data.db

# Scraping interval in seconds (used in --watch mode)
SCRAPE_INTERVAL=300

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# LDAP authentication (leave LDAP_URI empty to disable auth entirely)
LDAP_URI=ldap://ldap.example.com
LDAP_BASE_DN=DC=example,DC=com
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_DOMAIN=example.com

# Jira integration (leave empty to disable web UI badges)
JIRA_BASE_URL=https://jira.example.com
JIRA_USERNAME=
JIRA_PASSWORD=

# Optional: Jira project key (not numeric id) — used by jira_mcp_server jira_search_from_failure_text when project_key is omitted
# JIRA_DEFAULT_PROJECT=PROJ

# Standalone Jira MCP server (jira_mcp_server.py): optional tuning
# JIRA_MCP_PORT=8002
# JIRA_SNIPPET_MAX_LEN=200
# JIRA_SEARCH_MAX_RESULTS_CAP=50
# JIRA_VERIFY_SSL=false
# JIRA_HTTP_RETRIES=3
# JIRA_HTTP_RETRY_BACKOFF=0.6
# Jira issue details (jira_get_issue include_all_details / comments / worklog / changelog caps)
# JIRA_COMMENTS_MAX=100
# JIRA_WORKLOG_MAX=100
# JIRA_CHANGELOG_MAX=50
# JIRA_COMMENT_BODY_MAX=8000
